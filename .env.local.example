# Copy this file to .env.local (dev) and set the same values as environment
# variables on your host in production (Vercel project settings, or a
# systemd/.env file on a VPS). See README.md for the full setup walkthrough.

# From https://developer.spotify.com/dashboard -> your app -> Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must exactly match a Redirect URI registered on the Spotify app.
# Dev:  http://127.0.0.1:3000/api/auth/callback
# Prod: https://your-domain.tld/api/auth/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# Any long random string you make up yourself (e.g. `openssl rand -hex 32`).
# Gates /api/auth/login and /api/auth/callback so strangers can't trigger
# your app's OAuth flow on the public deployment.
SPOTIFY_SETUP_KEY=

# Obtained once by visiting /api/auth/login?key=<SPOTIFY_SETUP_KEY> and
# completing the Spotify consent screen — see README.md. Leave empty until
# you've done that.
SPOTIFY_REFRESH_TOKEN=

# --- Listening history (stats.fm-style stats) ---

# Turso (libSQL) database, used to store every tracked play so real
# per-artist/track/album minutes can be computed. Required in production
# on Vercel (no persistent disk there). Leave both empty for local dev —
# falls back to a local SQLite file at ./data/pulsar.db.
# Create one at https://turso.tech (free tier) — `turso db create pulsar`
# then `turso db show pulsar --url` and `turso db tokens create pulsar`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Any long random string (e.g. `openssl rand -hex 32`). Protects
# /api/cron/poll-history so only your scheduler (see
# .github/workflows/poll-history.yml) can trigger it.
CRON_SECRET=
